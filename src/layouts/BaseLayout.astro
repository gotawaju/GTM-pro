---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GTM Digest",
  description = "米国GTMの重要情報を、日本語の判定つきで読む週次ダイジェスト"
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="GTM Digest ホーム">
        <span class="brand-mark">GTM</span>
        <span class="brand-name">DIGEST</span>
      </a>
      <p>米国GTMの変化を、日本語で見極める。</p>
    </header>
    <slot />
    <footer class="site-footer">
      <span>GTM Digest</span>
      <span>原典を読み、判断するための週次インデックス</span>
    </footer>
  </body>
</html>
